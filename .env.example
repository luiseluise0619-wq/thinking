# THINK OS 환경변수 — 복사해서 .env 로 쓰세요:  cp .env.example .env

# Gemini API 키 (서버에만 보관 · 브라우저에 노출 안 됨). 없으면 규칙 기반으로 동작.
GEMINI_API_KEY=

# (선택) 모델 지정
THINKOS_GEMINI_MODEL=gemini-2.5-flash

# CORS 허용 오리진. 프로덕션에선 실제 도메인만! (쉼표로 여러 개)
# 예: https://think.example.com
THINKOS_ALLOWED_ORIGINS=*

# 계정 기능(로그인/서버 저장)용 — 토큰 서명 비밀키. 프로덕션에선 반드시 랜덤 문자열로!
#   생성 예: python -c "import secrets;print(secrets.token_urlsafe(32))"
THINKOS_SECRET=dev-insecure-secret-change-me

# 코호트 검증 대시보드(/admin/cohort) 접근용 관리자 시크릿. 비우면 비활성.
THINKOS_ADMIN_SECRET=
